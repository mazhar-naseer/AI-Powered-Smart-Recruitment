ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
POSTGRES_DB=smarthire
POSTGRES_USER=smarthire
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://smarthire:replace-with-a-strong-password@localhost:5432/smarthire
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
RESUME_STORAGE_PATH=./storage/resumes
MAX_RESUME_SIZE_MB=5
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# Production email verification (local development writes messages to .outbox).
# BREVO_API_KEY takes precedence and delivers over HTTPS. Use it on hosts that
# block outbound SMTP — Railway blocks ports 25/465/587/2525 below the Pro plan.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=SmartHire
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

# Optional AI enrichment. Deterministic matching remains available without this.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ENABLED=true
# Gemini may influence at most 50% of the final score. Recommended maximum: 35%.
GEMINI_WEIGHT=0.35
GEMINI_TIMEOUT_SECONDS=30
HYBRID_DISAGREEMENT_THRESHOLD=25
LOG_LEVEL=INFO

# Commercial SaaS. "manual" is fully functional for local testing.
# Configure a payment-provider adapter and webhook secret before production billing.
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=
TRIAL_DAYS=14

# Free Google OpenID Connect login
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/google/callback
