ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
POSTGRES_DB=smarthire
POSTGRES_USER=smarthire
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://smarthire:replace-with-a-strong-password@localhost:5432/smarthire
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
RESUME_STORAGE_PATH=./storage/resumes
AVATAR_STORAGE_PATH=./storage/avatars
MAX_RESUME_SIZE_MB=5

# Set USE_CLOUDINARY=true on any host with an ephemeral filesystem — uploads
# written to local disk there are lost on every redeploy, restart, and idle
# spin-down. With it on, resumes and avatars are read and written on Cloudinary
# exclusively and the paths above are unused. All three credentials are then
# required; the app refuses to start without them rather than silently writing
# to a disk that will not survive.
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seeds the first administrator at startup, since registration refuses the admin
# role and a fresh deployment would otherwise have no way in. Applied only when
# no administrator exists: it never resets a password or promotes an existing
# account, so it is safe to leave set. Further administrators are created from
# the Control Center once you sign in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# Production email verification (local development writes messages to .outbox).
# BREVO_API_KEY takes precedence and delivers over HTTPS. Use it on hosts that
# block outbound SMTP — Railway blocks ports 25/465/587/2525 below the Pro plan.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=SmartHire
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

# Set to false to skip the OTP email: registration activates the account
# immediately and sends the user straight to login. Existing unverified
# accounts can also log in while this is off.
EMAIL_VERIFICATION_ENABLED=true

# Optional AI enrichment. Deterministic matching remains available without this.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ENABLED=true
# Gemini may influence at most 50% of the final score. Recommended maximum: 35%.
GEMINI_WEIGHT=0.35
GEMINI_TIMEOUT_SECONDS=30
HYBRID_DISAGREEMENT_THRESHOLD=25
LOG_LEVEL=INFO

# Commercial SaaS. "manual" is fully functional for local testing.
# Configure a payment-provider adapter and webhook secret before production billing.
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=
TRIAL_DAYS=14

# Free Google OpenID Connect login
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/google/callback
